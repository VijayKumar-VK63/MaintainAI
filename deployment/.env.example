# Deployment environment variables
# Copy to .env and fill in values (never commit .env)

# Remote SLM inference endpoint (choose one)
# Option A: Hugging Face Inference Endpoint
# SLM_INFERENCE_ENDPOINT=https://api-inference.huggingface.co/models/your-username/maintainai-qwen2.5-3b-lora
# HF_TOKEN=hf_xxxxxxxxxxxx

# Option B: RunPod/vLLM self-hosted
# SLM_INFERENCE_ENDPOINT=http://your-runpod-ip:8000/v1/completions

# Option C: Local vLLM server (Docker)
# SLM_INFERENCE_ENDPOINT=http://localhost:8000/v1/completions

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Configuration
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

# Model Configuration
SLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
SLM_ADAPTER_PATH=/path/to/adapter  # For local vLLM server