# Copy to .env (never commit .env). Placeholder values only.
# SLM backend: auto | demo | transformers | llamacpp | openai
# auto -> remote endpoint, else local GGUF, else transformers adapter (no demo).
SLM_BACKEND=auto
SLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
# llamacpp backend (CPU): quantized base .gguf; adapter is the GGUF LoRA
SLM_MODEL_PATH=
SLM_ADAPTER_PATH=
SLM_LORA_SCALE=1.0
SLM_CONSTRAINED=true
SLM_N_CTX=2048
SLM_N_THREADS=
SLM_N_BATCH=512
SLM_MAX_NEW_TOKENS=256
SLM_TEMPERATURE=0.2
SLM_CHAT_MAX_NEW_TOKENS=96
SLM_CHAT_TEMPERATURE=0.0
SLM_INFERENCE_ENDPOINT=
SLM_INFERENCE_PATH=/v1/chat/completions
SLM_API_KEY=
HF_TOKEN=
API_BASE_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
MODEL_DIR=models
