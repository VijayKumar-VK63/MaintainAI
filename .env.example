# Copy to .env (never commit .env). Placeholder values only.
# SLM backend: demo | transformers | llamacpp | openai
SLM_BACKEND=demo
SLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
# llamacpp backend (CPU): quantized base .gguf; adapter is the GGUF LoRA
SLM_MODEL_PATH=
SLM_ADAPTER_PATH=
SLM_LORA_SCALE=1.0
SLM_CONSTRAINED=true
SLM_INFERENCE_ENDPOINT=
SLM_INFERENCE_PATH=/v1/chat/completions
SLM_API_KEY=
HF_TOKEN=
API_BASE_URL=http://127.0.0.1:8000
MODEL_DIR=models
